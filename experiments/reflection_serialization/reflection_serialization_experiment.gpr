with "flyology_serde";
with "flyology_reflection";

project Reflection_Serialization_Experiment is
   Reflection_Root := external ("FLYOLOGY_REFLECTION_ROOT");
   Build_Root := external ("FLYOLOGY_SERDE_REFLECTION_BUILD_ROOT", ".");

   for Source_Dirs use
     ("src",
      Reflection_Root & "/experiments/private_child_experiment/src",
      Reflection_Root & "/experiments/private_child_experiment/generated");
   for Object_Dir use Build_Root & "/obj";
   for Exec_Dir use Build_Root & "/bin";
   for Main use ("reflection_serialization_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatw.X", "-gnatyM110");
   end Compiler;
end Reflection_Serialization_Experiment;
