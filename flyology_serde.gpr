with "config/flyology_serde_config.gpr";
project Flyology_Serde is

   for Library_Name use "Flyology_Serde";
   for Library_Version use Project'Library_Name & ".so." & Flyology_Serde_Config.Crate_Version;

   type Test_Hook_Mode is ("disabled", "enabled");
   Test_Hooks : Test_Hook_Mode :=
     external ("FLYOLOGY_SERDE_TEST_HOOKS", "disabled");
   case Test_Hooks is
      when "disabled" =>
         for Source_Dirs use ("src/", "src/test_hooks_disabled/", "config/");
         for Object_Dir use "obj/" & Flyology_Serde_Config.Build_Profile;
         for Library_Dir use "lib";
      when "enabled" =>
         for Source_Dirs use
           ("src/", "tests/src/test_hooks_enabled/", "config/");
         for Object_Dir use
           "tests/obj/serde_enabled/" & Flyology_Serde_Config.Build_Profile;
         for Library_Dir use "tests/lib/serde_enabled";
   end case;
   for Create_Missing_Dirs use "True";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("FLYOLOGY_SERDE_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use
        Flyology_Serde_Config.Ada_Compiler_Switches & ("-gnatyM110", "-gnat2022");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Flyology_Serde;
