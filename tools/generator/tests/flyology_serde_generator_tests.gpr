with "config/flyology_serde_generator_tests_config.gpr";
project Flyology_Serde_Generator_Tests is
   for Source_Dirs use ("src", "fixtures", "golden");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("flyology_serde_generator_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Flyology_Serde_Generator_Tests_Config.Ada_Compiler_Switches
        & ("-gnatyM110", "-gnat2022", "-gnata");
   end Compiler;
end Flyology_Serde_Generator_Tests;
