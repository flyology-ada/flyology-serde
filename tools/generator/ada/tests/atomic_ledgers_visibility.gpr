with "../config/flyology_serde_generator_config.gpr";

project Atomic_Ledgers_Visibility is
   for Source_Dirs use ("visibility_probe", "../src", "../config");
   for Object_Dir use "obj/atomic_ledgers_visibility";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        Flyology_Serde_Generator_Config.Ada_Compiler_Switches &
          ("-gnatyM110", "-gnat2022", "-gnata");
   end Compiler;
end Atomic_Ledgers_Visibility;
