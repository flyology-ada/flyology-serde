             (Flyology_Serde_Generator.Diagnostics.Code (Bad_Diagnostic)
                = Flyology_Serde_Generator
                    .Diagnostics
                    .Unsupported_Lowered_Model);
         pragma
           Assert
             (not Flyology_Serde_Generator.Requests.Is_Poisoned (Bad_Budget));
      end;
   end;

