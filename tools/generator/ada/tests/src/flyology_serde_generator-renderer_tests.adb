   Flyology_Serde_Generator.Rendering.Render_Payload
     (Model, Budget, Rendered, Diagnostic);
   pragma
     Assert
       (Flyology_Serde_Generator.Diagnostics.Code (Diagnostic)
          = Flyology_Serde_Generator.Diagnostics.No_Error);
   pragma Assert (Flyology_Serde_Generator.Rendering.Is_Valid (Rendered));
   pragma
     Assert (Flyology_Serde_Generator.Rendering.Artifact_Count (Rendered) = 2);
   pragma
     Assert
       (Flyology_Serde_Generator.Rendering.File_Name
          (Rendered, Flyology_Serde_Generator.Rendering.Specification)
          = "flyology-generated.ads");
   pragma
     Assert
       (Flyology_Serde_Generator.Rendering.File_Name
          (Rendered, Flyology_Serde_Generator.Rendering.Package_Body)
          = "flyology-generated.adb");
   declare
      Tiny    : String (5 .. 5) := "x";
      Written : Natural := 42;
      Copied  : Boolean;
   begin
      Flyology_Serde_Generator.Rendering.Copy_Payload
        (Rendered,
         Flyology_Serde_Generator.Rendering.Specification,
         Tiny,
         Written,
         Copied);
      pragma Assert (not Copied);
      pragma Assert (Tiny = "x");
      pragma Assert (Written = 42);
   end;

   declare
      Spec               : constant String :=
        Copied_Payload
          (Rendered, Flyology_Serde_Generator.Rendering.Specification);
      Body_Text          : constant String :=
        Copied_Payload
          (Rendered, Flyology_Serde_Generator.Rendering.Package_Body);
      Golden_Spec_Source : constant String :=
        Read_Exact (Ada.Command_Line.Argument (1));
      Usage              :
        constant Flyology_Serde_Generator.Requests.Budget_Usage :=
          Flyology_Serde_Generator.Requests.Current_Usage (Budget);
      Exact              :
        Flyology_Serde_Generator.Requests.Generation_Limits := Limits;
      Prior              : constant String := Spec;
   begin
      pragma Assert (Spec = Strip_Seven_Line_Header (Golden_Spec_Source));
      pragma
        Assert
          (Body_Text
             = Strip_Seven_Line_Header
                 (Read_Exact (Ada.Command_Line.Argument (2))));
      pragma
        Assert
          (Spec
             = Strip_Seven_Line_Header
                 (Read_Exact (Ada.Command_Line.Argument (3))));
      pragma
        Assert
          (Body_Text
             = Strip_Seven_Line_Header
                 (Read_Exact (Ada.Command_Line.Argument (4))));
      declare
         Bad_Marker : String := Golden_Spec_Source;
         Bad_CR     : String := Golden_Spec_Source;
         Bad_Hex    : String := Golden_Spec_Source;
         Hex_Prefix : constant String := "--  Generator source SHA-256: ";
         Hex_Start  : constant Positive :=
           Ada.Strings.Fixed.Index (Golden_Spec_Source, Hex_Prefix)
           + Hex_Prefix'Length;
      begin
         Bad_Marker (Bad_Marker'First) := 'x';
         Bad_CR (Bad_CR'First + 4) := ASCII.CR;
         Bad_Hex (Hex_Start) := 'A';
         pragma Assert (Rejects_Header (Bad_Marker));
         pragma Assert (Rejects_Header (Bad_CR));
         pragma Assert (Rejects_Header (Bad_Hex));
         pragma
           Assert
             (Rejects_Header
                (Golden_Spec_Source (Golden_Spec_Source'First .. Hex_Start - 1)
                 & Golden_Spec_Source
                     (Hex_Start + 1 .. Golden_Spec_Source'Last)));
      end;
      pragma Assert (Usage.Artifact_Files = 2);
      pragma
        Assert
          (Usage.Rendered_Bytes
             = Flyology_Serde_Generator.Requests.Used_Value
                 (Spec'Length + Body_Text'Length));
      pragma
        Assert
          (Usage.Work_Units
             = Lower_Usage.Work_Units
               + Flyology_Serde_Generator.Requests.Used_Value
                   (Spec'Length + Body_Text'Length + 4));

      Exact.Maximum_Rendered_Bytes_Per_File :=
        Flyology_Serde_Generator.Requests.Limit_Value
          (Natural'Max (Spec'Length, Body_Text'Length));
      Exact.Maximum_Total_Rendered_Bytes :=
        Flyology_Serde_Generator.Requests.Limit_Value
          (Spec'Length + Body_Text'Length);
      Exact.Maximum_Work_Units :=
        Flyology_Serde_Generator.Requests.Limit_Value
          (Spec'Length + Body_Text'Length + 4);
      Flyology_Serde_Generator.Requests.Start_Budget (Exact, Budget);
      Flyology_Serde_Generator.Rendering.Render_Payload
        (Model, Budget, Again, Diagnostic);
      pragma
        Assert
          (Flyology_Serde_Generator.Diagnostics.Code (Diagnostic)
             = Flyology_Serde_Generator.Diagnostics.No_Error);
      pragma
        Assert
          (Copied_Payload
             (Again, Flyology_Serde_Generator.Rendering.Specification)
             = Spec);

      declare
         Attempt : Flyology_Serde_Generator.Requests.Generation_Limits :=
           Exact;
      begin
         Attempt.Maximum_Rendered_Bytes_Per_File :=
           Exact.Maximum_Rendered_Bytes_Per_File - 1;
         Expect_Exhausted (Model, Attempt, Rendered, Prior);
         Attempt := Exact;
         Attempt.Maximum_Total_Rendered_Bytes :=
           Exact.Maximum_Total_Rendered_Bytes - 1;
         Expect_Exhausted (Model, Attempt, Rendered, Prior);
         Attempt := Exact;
         Attempt.Maximum_Artifact_Files := 1;
         Expect_Exhausted (Model, Attempt, Rendered, Prior);
         Attempt := Exact;
         Attempt.Maximum_Work_Units := Exact.Maximum_Work_Units - 1;
         Expect_Exhausted (Model, Attempt, Rendered, Prior);
         Attempt := Exact;
         Attempt.Maximum_Work_Units := 3;
         Expect_Exhausted (Model, Attempt, Rendered, Prior);
      end;
   end;

   declare
      Empty : Flyology_Serde_Generator.Lowered_Records.Model;
      Prior : constant String :=
        Copied_Payload
          (Again, Flyology_Serde_Generator.Rendering.Specification);
   begin
      Flyology_Serde_Generator.Requests.Start_Budget (Limits, Budget);
      Flyology_Serde_Generator.Rendering.Render_Payload
        (Empty, Budget, Again, Diagnostic);
      pragma
        Assert
          (Flyology_Serde_Generator.Diagnostics.Code (Diagnostic)
             = Flyology_Serde_Generator.Diagnostics.Unsupported_Lowered_Model);
      pragma
        Assert
          (Copied_Payload
             (Again, Flyology_Serde_Generator.Rendering.Specification)
             = Prior);
   end;

   for Kind in
     Flyology_Serde_Generator.Lowered_Records.Test_Fixtures.Malformation
   loop
      declare
         Bad   : constant Flyology_Serde_Generator.Lowered_Records.Model :=
           Flyology_Serde_Generator.Lowered_Records.Test_Fixtures.Malformed
             (Kind);
         Prior : constant String :=
           Copied_Payload
             (Again, Flyology_Serde_Generator.Rendering.Specification);
      begin
         Flyology_Serde_Generator.Requests.Start_Budget (Limits, Budget);
         Flyology_Serde_Generator.Rendering.Render_Payload
           (Bad, Budget, Again, Diagnostic);
         pragma
           Assert
             (Flyology_Serde_Generator.Diagnostics.Code (Diagnostic)
                = Flyology_Serde_Generator
                    .Diagnostics
                    .Unsupported_Lowered_Model,
              Flyology_Serde_Generator
                .Lowered_Records
                .Test_Fixtures
                .Malformation'Image (Kind)
                & ":"
                & Flyology_Serde_Generator.Diagnostics.Stable_Name
                    (Diagnostic));
         pragma
           Assert (not Flyology_Serde_Generator.Requests.Is_Poisoned (Budget));
         pragma
           Assert
             (Copied_Payload
                (Again, Flyology_Serde_Generator.Rendering.Specification)
                = Prior);
      end;
   end loop;

   for Kind in
     Flyology_Serde_Generator.Lowered_Records.Test_Fixtures.Line_Boundary
   loop
      declare
         Accepted_Model :
           constant Flyology_Serde_Generator.Lowered_Records.Model :=
             Flyology_Serde_Generator.Lowered_Records.Test_Fixtures.Boundary
               (Kind, False);
         Rejected_Model :
           constant Flyology_Serde_Generator.Lowered_Records.Model :=
             Flyology_Serde_Generator.Lowered_Records.Test_Fixtures.Boundary
               (Kind, True);
      begin
         Flyology_Serde_Generator.Requests.Start_Budget (Limits, Budget);
         Flyology_Serde_Generator.Rendering.Render_Payload
           (Accepted_Model, Budget, Again, Diagnostic);
         pragma
           Assert
             (Flyology_Serde_Generator.Diagnostics.Code (Diagnostic)
                = Flyology_Serde_Generator.Diagnostics.No_Error);
         declare
            Prior : constant String :=
              Copied_Payload
                (Again, Flyology_Serde_Generator.Rendering.Specification);
            Usage : Flyology_Serde_Generator.Requests.Budget_Usage;
         begin
            Flyology_Serde_Generator.Requests.Start_Budget (Limits, Budget);
            Flyology_Serde_Generator.Rendering.Render_Payload
              (Rejected_Model, Budget, Again, Diagnostic);
            pragma
              Assert
                (Flyology_Serde_Generator.Diagnostics.Code (Diagnostic)
                   = Flyology_Serde_Generator
                       .Diagnostics
                       .Unsupported_Lowered_Model);
            Usage := Flyology_Serde_Generator.Requests.Current_Usage (Budget);
            pragma Assert (Usage.Artifact_Files = 0);
            pragma Assert (Usage.Rendered_Bytes = 0);
            pragma Assert (Usage.Work_Units = 0);
            pragma
              Assert
                (Copied_Payload
                   (Again, Flyology_Serde_Generator.Rendering.Specification)
                   = Prior);
         end;
      end;
   end loop;
end Flyology_Serde_Generator.Renderer_Tests;
