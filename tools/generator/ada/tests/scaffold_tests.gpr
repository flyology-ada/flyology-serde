with "../config/flyology_serde_generator_config.gpr";
with "json";
with "sha2";
project Scaffold_Tests is

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src", "../src", "../config", "../native");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use
     ("scaffold_tests.adb", "renderer_tests.adb", "build_sha_256_tests.adb", "build_budgets_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Flyology_Serde_Generator_Config.Ada_Compiler_Switches &
          ("-gnatyM110", "-gnat2022", "-gnata");
   end Compiler;
end Scaffold_Tests;
