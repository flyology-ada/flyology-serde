{
  "$id": "https://flyology.dev/schema/serde-generation-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "fixture_only": {
            "const": false
          }
        },
        "required": [
          "fixture_only"
        ]
      },
      "then": {
        "properties": {
          "type_ir_document": {
            "properties": {
              "authority": {
                "const": "production"
              }
            },
            "required": [
              "context_sha256"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "type_ir_document": {
            "not": {
              "required": [
                "context_sha256"
              ]
            },
            "properties": {
              "authority": {
                "const": "consumer_shape"
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "logical_path": {
            "pattern": "^[a-z0-9][a-z0-9_-]*\\.(ads|adb)$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "logical_path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "fixture_only": {
      "type": "boolean"
    },
    "generator_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "generator_version": {
      "const": "serde-generator-v2"
    },
    "manifest_version": {
      "const": 2
    },
    "overlay_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "type_ir_document": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "enum": [
            "production",
            "consumer_shape",
            "structural"
          ]
        },
        "context_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "semantic_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "authority",
        "semantic_fingerprint",
        "source_sha256"
      ],
      "type": "object"
    },
    "type_ir_library": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "crate": {
          "const": "flyology_type_ir"
        },
        "origin": {
          "minLength": 1,
          "pattern": "^[ -~]+$",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "^[ -~]+$",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "content_sha256",
        "crate",
        "origin",
        "version"
      ],
      "type": "object"
    }
  },
  "required": [
    "files",
    "fixture_only",
    "generator_identity_sha256",
    "generator_version",
    "manifest_version",
    "overlay_sha256",
    "type_ir_document",
    "type_ir_library"
  ],
  "title": "Flyology Serde generation manifest v2",
  "type": "object",
  "x-flyology-canonical-json": "UTF-8, sorted object keys, schema array order, no optional whitespace, final LF",
  "x-flyology-header-lines": [
    "--  {FLYOLOGY_SERDE_TEST_FIXTURE_ONLY|FLYOLOGY_SERDE_GENERATED}",
    "--  Generated by serde-generator-v2; do not edit.",
    "--  Generator identity SHA-256: {generator_identity_sha256}",
    "--  Type IR source SHA-256: {type_ir_document.source_sha256}",
    "--  Type IR semantic SHA-256: {type_ir_document.semantic_fingerprint}",
    "--  Overlay SHA-256: {overlay_sha256}",
    ""
  ],
  "x-flyology-ordering": {
    "files": "exactly one shared-stem .adb/.ads pair in strict unsigned-UTF-8 logical_path order"
  },
  "x-flyology-verifier": "enforces every x-flyology rule plus header/manifest equality and marker/authority consistency",
  "x-flyology-v1-migration": {
    "add": [
      "manifest_version",
      "generator_identity_sha256",
      "type_ir_document",
      "type_ir_library"
    ],
    "remove": [
      "generator_source_sha256",
      "type_ir_checker_sha256",
      "type_ir_commit",
      "type_ir_fixture_unit_sha256",
      "type_ir_schema_sha256",
      "type_ir_semantic_fingerprint",
      "type_ir_source_sha256"
    ],
    "replace": {
      "files": "artifact hashes after exact seven-line header replacement",
      "generator_version": "serde-generator-v2"
    },
    "retain": [
      "fixture_only",
      "overlay_sha256"
    ]
  }
}
