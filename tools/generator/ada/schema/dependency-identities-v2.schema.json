{
  "$id": "https://flyology.dev/schema/dependency-identities-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "source_kind": {
              "const": "git"
            }
          },
          "required": [
            "source_kind"
          ]
        },
        "then": {
          "required": [
            "commit"
          ]
        },
        "else": {
          "not": {
            "required": [
              "commit"
            ]
          }
        }
      }
    ],
    "properties": {
      "commit": {
        "pattern": "^[0-9a-f]{40,64}$",
        "type": "string"
      },
      "content_sha256": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "crate": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "origin": {
        "minLength": 1,
        "pattern": "^[ -~]+$",
        "type": "string"
      },
      "source_kind": {
        "enum": [
          "git",
          "registry"
        ]
      },
      "version": {
        "minLength": 1,
        "pattern": "^[ -~]+$",
        "type": "string"
      }
    },
    "required": [
      "content_sha256",
      "crate",
      "origin",
      "source_kind",
      "version"
    ],
    "type": "object"
  },
  "type": "array",
  "uniqueItems": true,
  "x-flyology-ordering": "strict ASCII crate-name order with no duplicate crate",
  "x-flyology-verifier": "enforces canonical JSON, ordering, unique crate names, and exact locked-origin content digests"
}
