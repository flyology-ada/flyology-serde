with "../config/flyology_serde_config.gpr";
project JSON_Event_Driver_Hook_Elision is
   Hook_Optimization := External ("HOOK_OPT", "-O0");
   type Hook_Mode is ("disabled", "enabled");
   Selection : Hook_Mode := External ("HOOK_MODE", "disabled");
   for Languages use ("Ada");
   case Selection is
      when "disabled" =>
         for Source_Dirs use
           ("../src", "../src/test_hooks_disabled", "hook_elision", "../config");
         for Object_Dir use "obj/json_hook_elision/disabled";
      when "enabled" =>
         for Source_Dirs use
           ("../src", "src/test_hooks_enabled", "hook_elision", "../config");
         for Object_Dir use "obj/json_hook_elision/enabled";
   end case;
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        Flyology_Serde_Config.Ada_Compiler_Switches &
          ("-gnatyM110", "-gnat2022", Hook_Optimization);
   end Compiler;
end JSON_Event_Driver_Hook_Elision;
