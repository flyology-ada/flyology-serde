with "flyology_serde";

project External_JSON_Oracle_Rejection is
   for Source_Dirs use ("src");
   for Object_Dir use "../obj/external_json_oracle_rejection";
   for Exec_Dir use "../bin";
   for Main use ("public_json_client.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatyM110");
   end Compiler;
end External_JSON_Oracle_Rejection;
